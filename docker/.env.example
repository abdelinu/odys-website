# Copy to .env and change every value before running anything that is not a
# throwaway container. docker compose reads .env automatically; .env is
# git-ignored so real credentials never reach the repository or the zip.
#
#   cd docker && cp .env.example .env && docker compose up -d
#
# Generate passwords rather than inventing them:
#   openssl rand -base64 24

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=prestashop
MYSQL_USER=odys
MYSQL_PASSWORD=change-me-db

# Back Office account created by the installer
ADMIN_MAIL=admin@odys.test
ADMIN_PASSWD=change-me-admin

# Where the shop answers, and what the admin folder is called
PS_DOMAIN=localhost:8080
PS_FOLDER_ADMIN=admin-odys
SHOP_PORT=8080
DB_PORT=3306

# 1 while developing (PrestaShop prints its warnings), 0 anywhere else
PS_DEV_MODE=1
