# Identifiants : jamais versionnes. verify.sh et docker-compose les lisent ici.
docker/.env
*.key

# Journaux de travail
*.log

# Brouillons
tmpwork/

# Systeme
Thumbs.db
desktop.ini
.DS_Store

# Les paquets que PrestaShop assemble lui-meme (CCC) : un nom par empreinte,
# refaits a chaque changement de feuille. Les suivre ne versionnait rien
# d'utile et laissait trainer des bundles perimes.
dist/odys-theme-ps8/themes/odys/assets/cache/*.css
dist/odys-theme-ps8/themes/odys/assets/cache/*.js
